# Template for tofu/backend.hcl (gitignored, not committed — these are the
# MinIO root credentials, not something to check in). Copy this file to
# backend.hcl and fill in the two values, then run:
#
#   tofu init -backend-config=backend.hcl
#
# See docs/src/bootstrap-environment/09-remote-state.md for where to get the
# credentials from (the live cluster's "minio-credentials" Secret in the
# "minio" namespace) and why they aren't sourced from tofu/secrets.enc.yaml.

access_key = "velero-admin"
secret_key = "REPLACE_ME"
